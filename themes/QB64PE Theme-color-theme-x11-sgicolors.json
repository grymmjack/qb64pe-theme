	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#555555",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.quoted.double",
				"markup.inline.raw",
				"markup.quote"
			],
			"settings": {
				"foreground": "#8e8e38"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#c67171"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#7171c6"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#7171c6"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#9c9cd7"
			}
		},
		{
			"scope": [
				"keyword.all.QB64PE",
				"keywords.all.QB64PE",
				"keyword.QB64PE",
				"keyword.control.QB64PE",
				"graphics.QB64PE",
				"sound.QB64PE"
			],
			"settings": {
				"foreground": "#7171c6"
			}
		},
		{
			"scope": [
				"metacommand.QB64PE",
				"debug.QB64PE"
			],
			"settings": {
				"foreground": "#71c671"
			}
		},
		{
			"scope": [
				"variable.other.QB64PE"
			],
			"settings": {
				"foreground": "#c5c1aa"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"userfunctions.QB64PE"
			],
			"settings": {
				"foreground": "#7ccb7c"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#c89ec8"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"entity.name.variable"
			],
			"settings": {
				"foreground": "#c5c1aa"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#9c9cd7",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.heading",
			"settings": {
				"foreground": "#8e8e38",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"foreground": "#c5c1aa",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"foreground": "#c5c1aa",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#71c671"
			}
		},
		{
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#c67171"
			}
		},
		{
			"scope": "markup.changed",
			"settings": {
				"foreground": "#8e8e38"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#c67171"
			}
		}
	]
}
