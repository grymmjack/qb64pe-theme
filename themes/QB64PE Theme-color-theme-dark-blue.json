	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#31c4c4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.quoted.double",
				"markup.inline.raw",
				"markup.quote"
			],
			"settings": {
				"foreground": "#ffb100"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#f580b1"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#4593d8"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#4593d8"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#7db3e4"
			}
		},
		{
			"scope": [
				"keyword.all.QB64PE",
				"keywords.all.QB64PE",
				"keyword.QB64PE",
				"keyword.control.QB64PE",
				"graphics.QB64PE",
				"sound.QB64PE"
			],
			"settings": {
				"foreground": "#4593d8"
			}
		},
		{
			"scope": [
				"metacommand.QB64PE",
				"debug.QB64PE"
			],
			"settings": {
				"foreground": "#55ff55"
			}
		},
		{
			"scope": [
				"variable.other.QB64PE"
			],
			"settings": {
				"foreground": "#e2e2e2"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"userfunctions.QB64PE"
			],
			"settings": {
				"foreground": "#63ff63"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#83cad9"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"entity.name.variable"
			],
			"settings": {
				"foreground": "#e2e2e2"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#7db3e4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.heading",
			"settings": {
				"foreground": "#ffb100",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"foreground": "#e2e2e2",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"foreground": "#e2e2e2",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#55ff55"
			}
		},
		{
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#f580b1"
			}
		},
		{
			"scope": "markup.changed",
			"settings": {
				"foreground": "#ffb100"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#f580b1"
			}
		}
	]
}
