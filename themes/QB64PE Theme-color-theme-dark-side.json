	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#31baf5",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.quoted.double",
				"markup.inline.raw",
				"markup.quote"
			],
			"settings": {
				"foreground": "#00b100"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#f50a62"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#cece00"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#cece00"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#dddd4d"
			}
		},
		{
			"scope": [
				"keyword.all.QB64PE",
				"keywords.all.QB64PE",
				"keyword.QB64PE",
				"keyword.control.QB64PE",
				"graphics.QB64PE",
				"sound.QB64PE"
			],
			"settings": {
				"foreground": "#cece00"
			}
		},
		{
			"scope": [
				"metacommand.QB64PE",
				"debug.QB64PE"
			],
			"settings": {
				"foreground": "#55ff55"
			}
		},
		{
			"scope": [
				"variable.other.QB64PE"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"userfunctions.QB64PE"
			],
			"settings": {
				"foreground": "#63ff63"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#83cad9"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"entity.name.variable"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#dddd4d",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.heading",
			"settings": {
				"foreground": "#00b100",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#55ff55"
			}
		},
		{
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#f50a62"
			}
		},
		{
			"scope": "markup.changed",
			"settings": {
				"foreground": "#00b100"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#f50a62"
			}
		}
	]
}
