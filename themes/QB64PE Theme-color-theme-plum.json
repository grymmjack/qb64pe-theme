	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#55baff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"string.quoted",
				"string.quoted.double",
				"markup.inline.raw",
				"markup.quote"
			],
			"settings": {
				"foreground": "#ff6c00"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#f580b1"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"storage",
				"storage.type",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "entity.name.tag",
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": "entity.other.attribute-name",
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"keyword.all.QB64PE",
				"keywords.all.QB64PE",
				"keyword.QB64PE",
				"keyword.control.QB64PE",
				"graphics.QB64PE",
				"sound.QB64PE"
			],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{
			"scope": [
				"metacommand.QB64PE",
				"debug.QB64PE"
			],
			"settings": {
				"foreground": "#55ba4e"
			}
		},
		{
			"scope": [
				"variable.other.QB64PE"
			],
			"settings": {
				"foreground": "#bababa"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"userfunctions.QB64PE"
			],
			"settings": {
				"foreground": "#63c05c"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"support.type",
				"support.class"
			],
			"settings": {
				"foreground": "#83cad9"
			}
		},
		{
			"scope": [
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"entity.name.variable"
			],
			"settings": {
				"foreground": "#bababa"
			}
		},
		{
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#ffffff",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.heading",
			"settings": {
				"foreground": "#ff6c00",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.bold",
			"settings": {
				"foreground": "#bababa",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "markup.italic",
			"settings": {
				"foreground": "#bababa",
				"fontStyle": "italic"
			}
		},
		{
			"scope": "markup.inserted",
			"settings": {
				"foreground": "#55ba4e"
			}
		},
		{
			"scope": "markup.deleted",
			"settings": {
				"foreground": "#f580b1"
			}
		},
		{
			"scope": "markup.changed",
			"settings": {
				"foreground": "#ff6c00"
			}
		},
		{
			"scope": "invalid",
			"settings": {
				"foreground": "#f580b1"
			}
		}
	]
}
